#. Plugin URI of the plugin
#: leanroles.php
msgid "https://example.com/leanroles"
msgstr ""

#. Description of the plugin
#: leanroles.php
msgid ""
"Measures what your role configuration costs on every request, and adds user "
"tags — a zero-capability primitive that behaves like a role without weighing "
"like one."
msgstr "Mide lo que cuesta tu configuración de roles en cada petición, y añade etiquetas de usuario: una primitiva sin capacidades que se comporta como un rol sin pesar como uno."


#. translators: %s: current PHP version.
#: leanroles.php:55
#, php-format
msgid ""
"LeanRoles requires PHP 7.4 or newer. This site runs PHP %s, so the plugin "
"has not been loaded."
msgstr "LeanRoles necesita PHP 7.4 o posterior. Este sitio usa PHP %s, así que el plugin no se ha cargado."


#: src/Admin/AuditPage.php:22
msgid "You do not have permission to view the role audit."
msgstr "No tienes permiso para ver la auditoría de roles."


#: src/Admin/AuditPage.php:44 src/Admin/Menu.php:47
msgid "Role audit"
msgstr "Auditoría de roles"


#: src/Admin/AuditPage.php:47
msgid ""
"Everything on this page is read. Nothing here writes to your role "
"configuration, your users, or anything else — you can leave this installed "
"on a client site without asking anyone first."
msgstr "Todo en esta página se lee. Nada de aquí escribe en tu configuración de roles, en tus usuarios ni en nada más: puedes dejar esto instalado en el sitio de un cliente sin pedir permiso a nadie."


#: src/Admin/AuditPage.php:71
msgid "Role option"
msgstr "Opción de roles"


#: src/Admin/AuditPage.php:74
