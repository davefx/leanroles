msgid "Run the benchmark"
msgstr "Ejecutar la medición"


#: src/Admin/AuditPage.php:296
msgid "Recalculate"
msgstr "Recalcular"


#: src/Admin/AuditPage.php:309
msgid "Stack"
msgstr "Stack"


#: src/Admin/AuditPage.php:314
msgid "Persistent object cache"
msgstr "Caché de objetos persistente"


#: src/Admin/AuditPage.php:317
msgid "drop-in present, backend not identified"
msgstr "drop-in presente, backend sin identificar"


#: src/Admin/AuditPage.php:318
