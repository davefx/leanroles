#: src/Admin/AuditPage.php:194
#, php-format
msgid "mean of %s timed calls after a warm-up pass"
msgstr "media de %s llamadas cronometradas tras una pasada de calentamiento"


#: src/Admin/AuditPage.php:199
msgid "Resident memory, per worker"
msgstr "Memoria residente, por worker"


#: src/Admin/AuditPage.php:201
msgid "memory_get_usage() either side of the call, with the result kept alive"
msgstr "memory_get_usage() antes y después de la llamada, manteniendo vivo el resultado"


#: src/Admin/AuditPage.php:204
msgid "In memory versus on disk"
msgstr "En memoria frente a en disco"


#: src/Admin/AuditPage.php:206
msgid "every hashtable entry costs far more resident than its serialized bytes"
msgstr "cada entrada de hashtable cuesta en residente mucho más que sus bytes serializados"


#: src/Admin/AuditPage.php:209
msgid "Hashtable entries"
msgstr "Entradas de hashtable"


#: src/Admin/AuditPage.php:211
msgid "unserialize() scales with this, not with the byte count"
msgstr "unserialize() escala con esto, no con el número de bytes"


#: src/Admin/AuditPage.php:219
