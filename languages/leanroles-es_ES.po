msgstr "Ese punto de restauración no contiene ninguna opción de roles; se rechaza restaurarlo."


#: src/Support/Roles.php:164
msgid "The restore point failed its integrity check and has not been applied."
msgstr "El punto de restauración no ha pasado su comprobación de integridad y no se ha aplicado."


#: src/Support/Roles.php:170
msgid "The restore point did not unserialize to a role array."
msgstr "El punto de restauración no se ha deserializado como un array de roles."


#: src/Support/Roles.php:195
msgid "That role does not exist."
msgstr "Ese rol no existe."


#. translators: %s: role slug.
#: src/Support/Roles.php:205
#, php-format
msgid "The role \"%s\" is protected and cannot be deleted."
msgstr "El rol «%s» está protegido y no se puede borrar."


#: src/Support/Roles.php:212
msgid "The reassignment target role does not exist."
msgstr "El rol de destino de la reasignación no existe."
