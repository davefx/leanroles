<?xml version="1.0"?>
<ruleset name="UserTags">
	<description>
		Coding standards and, more usefully, the sniffs that catch real defects:
		unescaped output, unprepared SQL, missing nonce checks, and syntax that
		would fatal on the PHP versions the plugin claims to support.
	</description>

	<file>user-tags.php</file>
	<file>src</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!--
		The plugin header says 7.4, so that is what gets checked. Running the
		test suite on 8.5 proves nothing about the floor.
	-->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- The floor declared in the plugin header and readme.txt. -->
	<config name="minimum_wp_version" value="5.9"/>

	<rule ref="WordPress-Core">
		<!-- Namespaced files, one class each; the WP file-naming rule predates that. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Yoda conditions are enforced elsewhere in the ruleset already. -->
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
	</rule>

	<rule ref="WordPress-Docs">
		<!--
			Every file here opens with a docblock explaining what the single
			class in it is for and why it is built that way. A separate class
			comment would restate it, and the two would drift apart.
		-->
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="user-tags-lib"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="user_tags,UserTags"/>
		</properties>
	</rule>
</ruleset>
