{
    "name": "leanroles/leanroles",
    "description": "Audits what a WordPress role configuration costs on every request, and adds zero-capability user tags.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0",
        "wp-cli/wp-cli": "^2.12",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:multisite": "phpunit -c phpunit-multisite.xml.dist",
        "test:coverage": "phpunit --coverage-text",
        "db:start": "tests/bin/start-db.sh",
        "db:stop": "tests/bin/start-db.sh stop",
        "install-tests": "tests/bin/install.sh",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test:matrix": "tests/bin/matrix.sh",
        "check": [
            "@lint",
            "@test",
            "@test:multisite"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    }
}
